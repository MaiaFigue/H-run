\f0\b \cf0 \
Game Controls\
\pard\tx220\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\li720\fi-720\pardirnatural\partightenfactor0
\ls3\ilvl0\cf0 {\listtext	\uc0\u8226 	}Space bar: 
\f1\b0 makes the horse jump.\
\ls3\ilvl0
\f0\b {\listtext	\uc0\u8226 	}Left arrow keyboard: 
\f1\b0 makes the horse move to the left.
\f0\b \
{\listtext	\uc0\u8226 	}Right arrow keyboard: 
\f1\b0 makes the horse move to the right.\
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0

\f0\b \cf0 \
